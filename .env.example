# ---------- Required ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# Public contact shown on the legal pages and sent to MusicBrainz in the User-Agent
CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_SITE_NAME=Meloa Sounds

# Protects /api/admin/* (approve artist uploads, handle takedowns)
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---------- Free keys (strongly recommended) ----------
# YouTube Data API v3 – console.cloud.google.com → enable "YouTube Data API v3" → API key
YOUTUBE_API_KEY=
# Jamendo – devportal.jamendo.com → create app → client_id
JAMENDO_CLIENT_ID=
# Audius app name (any short string identifying your app)
AUDIUS_APP_NAME=MeloaSounds

# Last.fm – last.fm/api/account/create → API key (country top-track charts)
LASTFM_API_KEY=
# Any long random string; Vercel uses it to call the daily chart import (/api/cron/ingest)
CRON_SECRET=change-me-to-another-long-random-string

# ---------- Optional (needs approval) ----------
# Audiomack Data API – request a key via audiomack.com contact page (OAuth 1.0a consumer key/secret)
AUDIOMACK_CONSUMER_KEY=
AUDIOMACK_CONSUMER_SECRET=
